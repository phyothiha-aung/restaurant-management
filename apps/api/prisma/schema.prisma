// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  OWNER
  MANAGER
  BRANCH_MANAGER
  WAITER
  CHEF
  CASHIER
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum ExpenseCategory {
  INGREDIENTS
  UTILITIES
  RENT
  WAGES
  MAINTENANCE
  SUPPLIES
  TRANSPORT
  MARKETING
  TAXES_AND_FEES
  OTHER
}

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  jti       String   @unique
  tokenHash String
  createdAt DateTime @default(now())
  expiredAt DateTime

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model User {
  id       Int  @id @default(autoincrement())
  branchId Int?

  name         String
  email        String?    @unique
  passwordHash String?
  role         UserRole   @default(WAITER)
  status       UserStatus @default(PENDING)

  username String?
  pinHash  String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  verifiedAt  DateTime?

  branch          Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens   RefreshToken[]
  createdExpenses Expense[]      @relation("ExpenseCreatedBy")
  updatedExpenses Expense[]      @relation("ExpenseUpdatedBy")
  voidedExpenses  Expense[]      @relation("ExpenseVoidedBy")

  @@unique([branchId, username])
  @@index([branchId, role])
  @@map("users")
}

model Branch {
  id         Int     @id @default(autoincrement())
  branchCode String? @unique

  name    String
  address String?
  phone   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  expenses Expense[]

  @@map("branches")
}

model Expense {
  id Int @id @default(autoincrement())

  branchId    Int?
  createdById Int
  updatedById Int
  voidedById  Int?

  title       String          @db.VarChar(100)
  description String?         @db.VarChar(1000)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @db.Date
  status      ExpenseStatus   @default(ACTIVE)

  voidReason String?   @db.VarChar(300)
  voidedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User    @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  voidedBy  User?   @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([branchId, expenseDate, status])
  @@index([category, expenseDate])
  @@index([createdById])
  @@map("expenses")
}
