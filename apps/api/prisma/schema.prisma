// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  OWNER
  MANAGER
  BRANCH_MANAGER
  WAITER
  CHEF
  CASHIER
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum ExpenseCategory {
  INGREDIENTS
  UTILITIES
  RENT
  WAGES
  MAINTENANCE
  SUPPLIES
  TRANSPORT
  MARKETING
  TAXES_AND_FEES
  OTHER
}

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENT
}

enum StoredFilePurpose {
  EXPENSE
  RECIPE
  PRODUCT
}

enum StoredFileStatus {
  PENDING
  READY
  REJECTED
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  jti       String   @unique
  tokenHash String
  createdAt DateTime @default(now())
  expiredAt DateTime

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model User {
  id       Int  @id @default(autoincrement())
  branchId Int?

  name         String
  email        String?    @unique
  passwordHash String?
  role         UserRole   @default(WAITER)
  status       UserStatus @default(PENDING)

  username String?
  pinHash  String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  verifiedAt  DateTime?

  branch          Branch?             @relation(fields: [branchId], references: [id])
  refreshTokens   RefreshToken[]
  createdExpenses Expense[]           @relation("ExpenseCreatedBy")
  updatedExpenses Expense[]           @relation("ExpenseUpdatedBy")
  voidedExpenses  Expense[]           @relation("ExpenseVoidedBy")
  uploadedFiles   StoredFile[]
  attachedFiles   ExpenseAttachment[]
  productImages   ProductImage[]
  createdOrders   Order[]             @relation("OrderCreatedBy")
  updatedOrders   Order[]             @relation("OrderUpdatedBy")

  @@unique([branchId, username])
  @@index([branchId, role])
  @@map("users")
}

model Branch {
  id         Int     @id @default(autoincrement())
  branchCode String? @unique

  name    String
  address String?
  phone   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  expenses Expense[]
  orders   Order[]

  @@map("branches")
}

model Expense {
  id Int @id @default(autoincrement())

  branchId    Int?
  createdById Int
  updatedById Int
  voidedById  Int?

  title       String          @db.VarChar(100)
  description String?         @db.VarChar(1000)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  expenseDate DateTime        @db.Date
  status      ExpenseStatus   @default(ACTIVE)

  voidReason String?   @db.VarChar(300)
  voidedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  branch      Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  voidedBy    User?               @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  attachments ExpenseAttachment[]

  @@index([branchId, expenseDate, status])
  @@index([category, expenseDate])
  @@index([createdById])
  @@map("expenses")
}

model StoredFile {
  id String @id @default(uuid())

  uploadedById Int
  objectKey    String            @unique @db.VarChar(500)
  purpose      StoredFilePurpose
  originalName String            @db.VarChar(255)
  mimeType     String            @db.VarChar(100)
  sizeBytes    Int
  status       StoredFileStatus  @default(PENDING)
  expiresAt    DateTime
  readyAt      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  uploadedBy        User               @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  expenseAttachment ExpenseAttachment?
  productImage      ProductImage?

  @@index([uploadedById, status])
  @@index([status, expiresAt])
  @@map("stored_files")
}

model ExpenseAttachment {
  id Int @id @default(autoincrement())

  expenseId    Int
  fileId       String   @unique
  attachedById Int
  createdAt    DateTime @default(now())

  expense    Expense    @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  attachedBy User       @relation(fields: [attachedById], references: [id], onDelete: Restrict)

  @@index([expenseId])
  @@index([attachedById])
  @@map("expense_attachments")
}

model ProductCategory {
  id Int @id @default(autoincrement())

  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder, name])
  @@map("product_categories")
}

model Product {
  id Int @id @default(autoincrement())

  categoryId Int

  code        String?  @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(1000)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  addonAssignments ProductAddon[]
  image            ProductImage?

  @@index([categoryId, isActive, sortOrder, name])
  @@map("products")
}

model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int

  name      String   @db.VarChar(50)
  price     Decimal  @db.Decimal(14, 2)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([productId, isActive, sortOrder, name])
  @@map("product_variants")
}

model Addon {
  id Int @id @default(autoincrement())

  name      String   @db.VarChar(100)
  unitPrice Decimal  @db.Decimal(14, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productAssignments ProductAddon[]
  orderItemAddons    OrderItemAddon[]

  @@index([isActive, name])
  @@map("addons")
}

model ProductAddon {
  productId Int
  addonId   Int

  maxQuantity Int @default(1)
  sortOrder   Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  addon   Addon   @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@id([productId, addonId])
  @@index([addonId])
  @@index([productId, sortOrder])
  @@map("product_addons")
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId    Int      @unique
  fileId       String   @unique
  attachedById Int
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  attachedBy User       @relation(fields: [attachedById], references: [id], onDelete: Restrict)

  @@index([attachedById])
  @@map("product_images")
}

model Order {
  id Int @id @default(autoincrement())

  branchId    Int
  createdById Int
  updatedById Int

  status         OrderStatus   @default(OPEN)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  taxPercent     Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(14, 2)

  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User        @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  items     OrderItem[]

  @@index([branchId, status, createdAt])
  @@index([createdById, createdAt])
  @@map("orders")
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId          Int
  productVariantId Int

  productName  String  @db.VarChar(100)
  variantName  String  @db.VarChar(50)
  unitPrice    Decimal @db.Decimal(14, 2)
  quantity     Int     @default(1)
  baseSubtotal Decimal @db.Decimal(14, 2)
  addonTotal   Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  order          Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  addons         OrderItemAddon[]

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderItemAddon {
  orderItemId Int
  addonId     Int

  addonName   String  @db.VarChar(100)
  unitPrice   Decimal @db.Decimal(14, 2)
  quantity    Int     @default(1)
  totalAmount Decimal @db.Decimal(14, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  addon     Addon     @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@id([orderItemId, addonId])
  @@index([addonId])
  @@map("order_item_addons")
}
